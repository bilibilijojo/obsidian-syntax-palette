{
  "name": "obsidian-syntax-palette",
  "version": "0.5.2",
  "description": "Syntax color palettes for Markdown fenced code blocks in Obsidian Desktop.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/bilibilijojo/obsidian-syntax-palette.git"
  },
  "engines": {
    "node": "25.8.1"
  },
  "scripts": {
    "prepare-assets": "node tools/prepare-plugin-assets.cjs",
    "prepare-themes": "node tools/prepare-theme-assets.cjs",
    "check-themes": "node tools/prepare-theme-assets.cjs --check",
    "check-notices": "node tools/generate-third-party-notices.cjs",
    "update-notices": "node tools/generate-third-party-notices.cjs --write",
    "check-release-metadata": "node tools/check-release-metadata.cjs",
    "build": "npm run check-notices && npm run check-release-metadata && node tools/build-plugin.cjs",
    "package": "npm run build && node tools/package-plugin.cjs",
    "verify": "npm run check-themes && npm run check-notices && npm run check-release-metadata && npm test",
    "test": "node --test plugin-src/tests/*.test.cjs",
    "verify-build": "node tools/verify-build.cjs",
    "test:obsidian": "node tools/obsidian-v0.4.0-test.cjs",
    "test:webkit": "node tools/webkit-highlight-test.cjs",
    "test:webkit:ln": "node tools/webkit-line-number-test.cjs"
  },
  "dependencies": {
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "markdown-it": "14.3.3"
  },
  "author": {
    "name": "Frank",
    "url": "https://github.com/bilibilijojo"
  },
  "license": "Apache-2.0"
}
